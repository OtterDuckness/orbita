# Auth.js / NextAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Correos permitidos (coma-separados). Vacío = no entra nadie.
ALLOWLIST_EMAILS=

# Anthropic (asistente IA — Haiku 4.5)
ANTHROPIC_API_KEY=
# Tope estimado USD / usuario / mes UTC (default 5 si se omite; 0|off|none = sin tope).
# Override por usuario/mes desde /admin/agente-ia (tabla ia_tope_mensual).
# IA_COSTE_MAX_USD_MES=5

# MySQL (Cloud SQL)
# Local: pon DATABASE_HOST (IP pública) y deja INSTANCE_CONNECTION_NAME vacío.
# Autoriza tu IP en Cloud SQL → Redes.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=dev
DATABASE_PASSWORD=
DATABASE_NAME=orbita
# Segunda BD (sandbox de admins). Misma instancia; el interruptor está en Admin → Ajustes.
DATABASE_NAME_PRUEBAS=orbita_pruebas
# Cloud Run (lo pone el script de deploy): project:region:instance
INSTANCE_CONNECTION_NAME=

# Google Cloud Storage (adjuntos de chat). Vacío = sin adjuntos.
GCS_BUCKET=

# Digest por correo (Resend + Cloud Scheduler → /api/cron/digest-correo)
RESEND_API_KEY=
CRON_SECRET=
# Remitente verificado en Resend (ej. Órbita <noreply@tudominio.com>)
# Sin dominio verificado usa: onboarding@resend.dev (solo llega a tu correo de la cuenta Resend)
EMAIL_FROM=onboarding@resend.dev

# Resumen IA del digest (Google AI Studio → API key)
GEMINI_API_KEY=
# Opcional; por defecto gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# Holded API (Mi Zona: fichaje, ausencias, nóminas)
# Settings → Developers → Credentials → Bearer token con scopes Team & HR
# https://www.holded.com/developers/authentication
HOLDED_API_KEY=
